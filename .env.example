# =============================================================================
# Job Intelligence Platform — variáveis de ambiente
# Copie para `.env` e preencha. NUNCA versione o `.env`.
# =============================================================================

APP_ENV=development
PORT=3000
APPLICATION_TIMEZONE=America/Sao_Paulo

# Origem permitida para CORS. Em produção, informe o domínio exato.
CORS_ORIGIN=http://localhost:3000

# Páginas públicas /privacidade e /termos (exigidas pelo Google para aprovar o
# app OAuth). Nome do operador, e-mail de contato e URL pública do sistema.
PUBLIC_OPERATOR_NAME=Inovassie Acessoria
PUBLIC_CONTACT_EMAIL=inovassie@gmail.com
# APP_BASE_URL=https://seu-dominio.com
RATE_LIMIT_PER_MINUTE=240

# -----------------------------------------------------------------------------
# Banco
#
# A implementação atual usa SQLite embutido (node:sqlite). DB_PATH aponta o
# arquivo; vazio = data/h2a_system.db. Também é usado para o banco de teste.
#
# DATABASE_URL fica declarada para a migração planejada para PostgreSQL — ver
# docs/architecture.md. Enquanto STORAGE_BACKEND=sqlite, ela é ignorada.
# -----------------------------------------------------------------------------
# DB_PATH=
# DATABASE_URL=postgresql://user:password@postgres:5432/job_intelligence
# REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# Criptografia de segredos em repouso (spec §32) — OBRIGATÓRIA para o Gmail
#
# Gere uma chave com:
#   node -e "console.log(require('./core/security/secretBox').generateKey())"
#
# Guarde fora do banco. Trocar a chave invalida os tokens já gravados.
# -----------------------------------------------------------------------------
APP_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Gupy — MCP público de candidatos
#
# Endpoint oficial documentado (verificado em 2026-09-02). A documentação não
# descreve token para esta conexão, então AUTH_MODE=none é o padrão correto.
# -----------------------------------------------------------------------------
GUPY_MCP_ENABLED=true
GUPY_MCP_URL=https://candidates.mcp.api.gupy.io/mcp
GUPY_MCP_AUTH_MODE=none
GUPY_MCP_TOKEN=
GUPY_SYNC_ENABLED=false
GUPY_SYNC_INTERVAL_MINUTES=360

# -----------------------------------------------------------------------------
# Indeed — MCP oficial em beta
#
# Na data de verificação, a conexão oficial existe apenas via Claude Connector.
# Não há endpoint nem credencial publicados para backend próprio, então o
# adapter permanece desligado e reporta o estado honestamente.
#
# Ative APENAS quando o acesso oficial para cliente próprio for liberado.
# -----------------------------------------------------------------------------
INDEED_ENABLED=true
INDEED_CUSTOM_MCP_ENABLED=false
INDEED_MCP_URL=
INDEED_MCP_AUTH_MODE=
INDEED_MCP_CLIENT_ID=
INDEED_MCP_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Seasonal Jobs — feeds oficiais do DOL
#
# Os links da página oficial resolvem para downloads em ZIP sob esta base:
#   /datahub-search/sjCaseData/zip/jo/{YYYY-MM-DD}    790/790A
#   /datahub-search/sjCaseData/zip/h2a/{YYYY-MM-DD}   9142A
#   /datahub-search/sjCaseData/zip/h2b/{YYYY-MM-DD}   9142B
#
# Publicação diária à meia-noite do horário do leste dos EUA.
# -----------------------------------------------------------------------------
SEASONAL_FEED_ENABLED=true
SEASONAL_FEED_BASE_URL=https://api.seasonaljobs.dol.gov
SEASONAL_SYNC_TIMEZONE=America/New_York
SEASONAL_SYNC_HOUR=01

# -----------------------------------------------------------------------------
# Gmail — OAuth 2.0, escopo mínimo de envio (spec §26, §28)
#
# Crie as credenciais no Google Cloud Console, tipo "Aplicativo da Web".
# O redirect abaixo precisa estar cadastrado como URI autorizado.
# A senha da conta NUNCA é usada nem armazenada.
# -----------------------------------------------------------------------------
GMAIL_ENABLED=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/seasonal/gmail/callback
GMAIL_SCOPE=https://www.googleapis.com/auth/gmail.send
MAX_SEASONAL_APPLICATION_EMAILS_PER_DAY=50

# -----------------------------------------------------------------------------
# Timeouts de provedores externos (spec §49)
# -----------------------------------------------------------------------------
PROVIDER_CONNECT_TIMEOUT_SECONDS=5
PROVIDER_READ_TIMEOUT_SECONDS=30

# -----------------------------------------------------------------------------
# Provedor de IA — OPCIONAL (spec de agentes §4, §5, §59)
#
# O sistema funciona INTEIRO sem LLM: análise por ontologia curada, cartas por
# template com cada bloco condicionado a um fato do perfil. Com um provedor
# configurado, a leitura de requisitos ambíguos e a redação melhoram.
#
# Nenhuma regra de negócio depende do modelo. Cota, duplicata, permissão,
# autenticação e integridade são código determinístico, com ou sem LLM (§4).
#
# A CHAVE NUNCA VAI PARA O BANCO. Ele guarda apenas o NOME da variável abaixo;
# o valor fica no ambiente do servidor. Configure o provedor pela interface
# (Central de Robôs) ou por PUT /api/core/ai — e defina a variável aqui.
#
# Provedores: none (padrão) | anthropic | openai | gemini
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
EMBEDDING_MODEL=

# -----------------------------------------------------------------------------
# Automação (spec de agentes §49, §63)
#
# O agendador sobe junto com o servidor e fica EM ESPERA até ser habilitado.
# Habilite pela Central de Robôs ou por POST /api/core/scheduler/enable.
#
# APP_ENV=production sinaliza que o processo roda em servidor 24/7 — é o que a
# varredura de prontidão (`npm run readiness`) verifica para dizer se a
# autonomia é real ou dura só enquanto a máquina do usuário estiver ligada.
# -----------------------------------------------------------------------------
# SCHEDULER_TICK_SECONDS=60

# -----------------------------------------------------------------------------
# Armazenamento de documentos
#
# `local` guarda em private_uploads/, fora de qualquer diretório servido.
# `s3` está previsto na interface de storage — ver docs/architecture.md.
# As chaves preservam plataforma e país: users/{id}/{plataforma}/{pais}/resumes/
# -----------------------------------------------------------------------------
STORAGE_BACKEND=local
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
